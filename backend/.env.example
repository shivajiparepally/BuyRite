# Copy this file to .env and fill in real values before running the project.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=liquor_store
DB_USER=liquor_store
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS - the URL your React frontend runs on
CORS_ALLOWED_ORIGIN=http://localhost:5173
